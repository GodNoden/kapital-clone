---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import EcosystemSection from "../../components/EcosystemSection.astro";
import AccountHighlight from "../../components/AccountHighlight.astro";
import AppSection from "../../components/AppSection.astro";
import ApplePaySection from "../../components/ApplePaySection.astro";
import AwardsSection from "../../components/AwardsSection.astro";
import PartnersSection from "../../components/PartnersSection.astro";
import BlogSection from "../../components/BlogSection.astro";
import BottomCTA from "../../components/BottomCTA.astro";
import LegalSection from "../../components/LegalSection.astro";
import Footer from "../../components/Footer.astro";
import HubspotModal from "../../components/HubspotModal.astro";

const lang = "en";
---

<Layout
    title="Kapital: Financial solutions for businesses and individuals | Mexico"
>
    <Header lang={lang} />
    <main>
        <Hero lang={lang} />
        <EcosystemSection lang={lang} />
        <AccountHighlight lang={lang} />
        <AppSection lang={lang} />
        <ApplePaySection lang={lang} />
        <AwardsSection lang={lang} />
        <PartnersSection lang={lang} />
        <BlogSection lang={lang} />
        <BottomCTA lang={lang} />
        <LegalSection lang={lang} />
    </main>
    <Footer lang={lang} />
    <HubspotModal lang={lang} />
</Layout>
