---
import { t, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

const title = t(lang, "hero.slides.3.investmentCard.title");
const investedLabel = t(lang, "hero.slides.3.investmentCard.investedLabel");
const investedAmount = t(lang, "hero.slides.3.investmentCard.investedAmount");
const estimatedLabel = t(lang, "hero.slides.3.investmentCard.estimatedLabel");
const estimatedAmount = t(lang, "hero.slides.3.investmentCard.estimatedAmount");
---

<div class="inversion-wrapper">
    <img
        src="/hero/inversion-card-bg.svg"
        alt=""
        aria-hidden="true"
        class="inversion-bg"
    />
    <div class="inversion-overlay">
        <h3 class="inversion-title">{title}</h3>

        <div class="inversion-block inversion-block-invested">
            <p class="inversion-label">{investedLabel}</p>
            <p class="inversion-amount-sm">{investedAmount}</p>
        </div>

        <div class="inversion-block inversion-block-estimated">
            <p class="inversion-label">{estimatedLabel}</p>
            <p class="inversion-amount-lg">{estimatedAmount}</p>
        </div>
    </div>
</div>

<style>
    .inversion-wrapper {
        display: grid;
        width: 100%;
        aspect-ratio: 450 / 320;
        container-type: inline-size;
    }
    .inversion-bg,
    .inversion-overlay {
        grid-area: 1 / 1;
        width: 100%;
        height: 100%;
    }
    .inversion-bg {
        display: block;
    }
    .inversion-overlay {
        position: relative;
        color: #fff;
        font-family:
            "Inter",
            system-ui,
            -apple-system,
            sans-serif;
        -webkit-font-smoothing: antialiased;
    }
    .inversion-title {
        position: absolute;
        top: 7cqw;
        left: 6cqw;
        right: 6cqw;
        margin: 0;
        font-size: 5.8cqw;
        font-weight: 400;
        letter-spacing: -0.01em;
    }
    .inversion-block {
        position: absolute;
        left: 6cqw;
        right: 6cqw;
        display: flex;
        flex-direction: column;
    }
    .inversion-block-invested {
        top: 31cqw;
        gap: 0.6cqw;
    }
    .inversion-block-estimated {
        top: 47cqw;
        gap: 0.6cqw;
    }
    .inversion-label {
        margin: 0;
        font-size: 3.5cqw;
        font-weight: 400;
        opacity: 0.6;
    }
    .inversion-amount-sm {
        margin: 0;
        font-size: 5.8cqw;
        font-weight: 500;
        letter-spacing: -0.01em;
    }
    .inversion-amount-lg {
        margin: 0;
        font-size: 12.5cqw;
        font-weight: 400;
        letter-spacing: -0.02em;
        line-height: 1;
    }
</style>
