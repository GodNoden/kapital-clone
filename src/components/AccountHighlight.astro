---
// Sección con imagen de fondo + CTA
// Aquí es donde optimizamos: el formulario HubSpot NO se carga hasta que el usuario hace click
---

<section class="w-full relative overflow-clip h-[720px] md:h-[848px]">
    {/* Imagen de fondo */}
    <img
        src="/sections/cuenta-bg.webp"
        alt=""
        aria-hidden="true"
        class="absolute min-w-full min-h-full object-cover pointer-events-none"
        loading="lazy"
        decoding="async"
        width="1440"
        height="850"
    />

    {/* Overlay */}
    <div
        class="absolute inset-0 bg-gradient-to-t from-[rgba(21,18,10,1)] via-[rgba(21,18,10,0.8)] to-transparent md:bg-[rgba(25,22,16,0.6)]"
    >
    </div>

    {/* Contenido */}
    <div
        class="relative h-full w-full flex flex-col justify-end md:justify-center md:items-center gap-8 pb-14 px-4 md:p-0"
    >
        <div class="flex flex-col gap-6 items-center text-white md:text-center">
            <h2 class="text-4xl md:text-5xl text-balance max-w-[720px]">
                Tu dinero, libre y siempre a la mano
            </h2>
            <p class="text-base md:text-xl text-pretty max-w-[720px]">
                Abre tu cuenta desde $1,000 MXN y maneja tu dinero fácil con
                tarjeta de débito y SPEI al instante.
            </p>
        </div>
        <div class="mx-auto">
            <button
                type="button"
                class="activate-form rounded-full px-6 py-4 lg:px-8 lg:py-5 text-sm lg:text-base text-white bg-white/20 backdrop-blur-md hover:bg-white/30 transition-colors duration-300"
                aria-label="Solicitar mi cuenta Kapital"
            >
                Solicitar mi cuenta Kapital
            </button>
        </div>
    </div>
</section>
