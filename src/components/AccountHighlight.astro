---
import { t, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
---

<section class="w-full relative overflow-clip h-[720px] md:h-[848px]">
    {/* Imagen de fondo */}
    <img
        src="/sections/cuenta-bg.webp"
        alt=""
        aria-hidden="true"
        class="absolute min-w-full min-h-full object-cover pointer-events-none"
        loading="lazy"
        decoding="async"
        width="1440"
        height="850"
    />

    {/* Overlay */}
    <div
        class="absolute inset-0 bg-gradient-to-t from-[rgba(21,18,10,1)] via-[rgba(21,18,10,0.8)] to-transparent md:bg-[rgba(25,22,16,0.6)]"
    >
    </div>

    {/* Contenido */}
    <div
        class="relative h-full w-full flex flex-col justify-end md:justify-center md:items-center gap-8 pb-14 px-4 md:p-0"
    >
        <div class="flex flex-col gap-6 items-center text-white md:text-center">
            <h2
                class="text-3xl md:text-4xl lg:text-5xl text-white font-semibold leading-tight"
            >
                {t(lang, "accountHighlight.title")}
            </h2>
            <p class="text-base md:text-lg text-white/90 max-w-[600px]">
                {t(lang, "accountHighlight.description")}
            </p>
        </div>
        <div class="mx-auto">
            <button
                type="button"
                class="activate-form inline-flex items-center justify-center px-6 py-4 lg:px-8 lg:py-5 rounded-full text-base lg:text-lg bg-white text-kapital-black hover:bg-white/90 transition-colors"
            >
                {t(lang, "accountHighlight.cta")}
            </button>
        </div>
    </div>
</section>
