---
import SliderArrows from "./SliderArrows.astro";
import { t, type Lang } from "../i18n";
import InversionCard from "./InversionCard.astro";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

interface Slide {
    id: number;
    eyebrow?: string;
    lines: string[];
    copy: string;
    cta: { label: string; href: string; type?: "link" | "button" };
    theme: "light" | "dark";
    desktop: string;
    mobile: string;
    secondaryImage?: string;
    secondaryComponent?: "inversion";
    btnColor: string;
    btnColorHover: string;
    btnTextColor: string;
}

const getSlideText = (index: number, field: string): string => {
    const key = `hero.slides.${index}.${field}`;
    const value = t(lang, key);
    // Si t() devuelve la misma key, significa que no encontró la traducción
    return value === key ? "" : value;
};
const slides: Slide[] = [
    {
        id: 0,
        eyebrow: getSlideText(0, "eyebrow") || undefined,
        lines: [
            getSlideText(0, "title.0"),
            getSlideText(0, "title.1"),
            getSlideText(0, "title.2"),
        ],
        copy: getSlideText(0, "copy"),
        cta: {
            label: getSlideText(0, "cta"),
            href: "https://onboarding.kapital.com/",
            type: "link",
        },
        theme: "light",
        desktop: "/hero/slide-1-desktop.webp",
        mobile: "/hero/slide-1-mobile.webp",
        btnColor: "rgba(220, 214, 207, 0.75)",
        btnColorHover: "rgba(220, 214, 207, 0.9)",
        btnTextColor: "text-kapital-black",
    },
    {
        id: 1,
        lines: [
            getSlideText(1, "title.0"),
            getSlideText(1, "title.1"),
            getSlideText(1, "title.2"),
        ],
        copy: getSlideText(1, "copy"),
        cta: {
            label: getSlideText(1, "cta"),
            href: "/divisas/cambio-divisas-en-efectivo-personas",
        },
        theme: "dark",
        desktop: "/hero/slide-2-desktop.webp",
        mobile: "/hero/slide-2-mobile.webp",
        btnColor: "rgba(114, 108, 100, 0.75)",
        btnColorHover: "rgba(114, 108, 100, 0.9)",
        btnTextColor: "text-white",
    },
    {
        id: 2,
        lines: [
            getSlideText(2, "title.0"),
            getSlideText(2, "title.1"),
            getSlideText(2, "title.2"),
        ],
        copy: getSlideText(2, "copy"),
        cta: {
            label: getSlideText(2, "cta"),
            href: "#",
            type: "button",
        },
        theme: "dark",
        desktop: "/hero/slide-3-desktop.webp",
        mobile: "/hero/slide-3-mobile.webp",
        btnColor: "rgba(160, 155, 148, 0.75)",
        btnColorHover: "rgba(160, 155, 148, 0.9)",
        btnTextColor: "text-white",
    },
    {
        id: 3,
        lines: [
            getSlideText(3, "title.0"),
            getSlideText(3, "title.1"),
            getSlideText(3, "title.2"),
        ],
        copy: getSlideText(3, "copy"),
        cta: {
            label: getSlideText(3, "cta"),
            href: "/inversiones/cedes-empresarial",
        },
        theme: "dark",
        desktop: "/hero/slide-4-desktop.webp",
        mobile: "/hero/slide-4-desktop.webp",
        secondaryComponent: "inversion",
        btnColor: "rgba(144, 136, 127, 0.75)",
        btnColorHover: "rgba(144, 136, 127, 0.9)",
        btnTextColor: "text-white",
    },
];
---

<section class="w-full relative overflow-clip min-h-[842px] h-svh">
    <div class="hero-swiper relative w-full h-full">
        <div class="swiper-wrapper">
            {
                slides.map((slide, index) => (
                    <div
                        class:list={[
                            "swiper-slide relative flex items-center justify-center",
                            slide.theme === "light"
                                ? "text-kapital-black"
                                : "bg-black text-white",
                        ]}
                        data-theme={slide.theme}
                    >
                        {/* Imagen de fondo desktop */}
                        <img
                            src={slide.desktop}
                            alt=""
                            aria-hidden="true"
                            loading={index === 0 ? "eager" : "lazy"}
                            decoding={index === 0 ? "sync" : "async"}
                            fetchpriority={index === 0 ? "high" : "auto"}
                            class="absolute top-0 left-0 w-full h-full object-cover object-top hidden md:block"
                            width="1920"
                            height="1080"
                        />
                        {/* Imagen de fondo mobile */}
                        <img
                            src={slide.mobile}
                            alt=""
                            aria-hidden="true"
                            loading={index === 0 ? "eager" : "lazy"}
                            decoding={index === 0 ? "sync" : "async"}
                            fetchpriority={index === 0 ? "high" : "auto"}
                            class="absolute top-0 left-0 w-full h-full object-cover object-top md:hidden"
                            width="768"
                            height="1080"
                        />

                        {/* Overlay */}
                        <div
                            class:list={[
                                "absolute inset-0",
                                slide.theme === "light"
                                    ? "bg-gradient-to-t from-[var(--color-cream-gradient)] to-transparent md:bg-gradient-to-r md:from-[var(--color-cream-gradient)] md:to-transparent"
                                    : "bg-gradient-to-b from-black/70 to-transparent md:bg-gradient-to-r md:from-black/70 md:to-transparent",
                            ]}
                        />

                        {/* Contenido */}
                        <div class="container mx-auto relative items-end lg:items-center h-full grid gap-y-12 xl:grid-cols-12 px-4 lg:px-[56px] xl:max-w-[1600px] pt-36 pb-20 xl:py-40">
                            <div class="flex flex-col gap-y-8 xl:col-span-8 hero-content-to-fade">
                                {slide.eyebrow && (
                                    <p class="text-lg font-semibold">
                                        {slide.eyebrow}
                                    </p>
                                )}
                                <h2 class="text-[56px] lg:text-[72px] tracking-[-0.01em] leading-none">
                                    {slide.lines
                                        .filter(
                                            (line) => line && line.length > 0,
                                        )
                                        .map((line) => (
                                            <p>{line}</p>
                                        ))}
                                </h2>
                                <p class="text-base md:text-xl max-w-[32ch]">
                                    {slide.copy}
                                </p>
                                <div class="flex flex-wrap gap-3">
                                    {slide.cta.type === "button" ? (
                                        <button
                                            type="button"
                                            class:list={[
                                                "btn-glass-bg rounded-full px-6 py-4 text-base lg:px-8 lg:py-5 text-lg hover:brightness-110 transition-all duration-300",
                                                slide.btnTextColor,
                                            ]}
                                            style={`background-color: ${slide.btnColor}; backdrop-filter: blur(12.5px);`}
                                        >
                                            {slide.cta.label}
                                        </button>
                                    ) : (
                                        <a
                                            href={slide.cta.href}
                                            class:list={[
                                                "btn-glass-bg rounded-full px-6 py-4 text-base lg:px-8 lg:py-5 text-lg hover:brightness-110 transition-all duration-300",
                                                slide.btnTextColor,
                                            ]}
                                            style={`background-color: ${slide.btnColor}; backdrop-filter: blur(12.5px);`}
                                        >
                                            {slide.cta.label}
                                        </a>
                                    )}
                                </div>
                            </div>

                            {slide.secondaryComponent === "inversion" && (
                                <div class="hidden lg:block xl:col-span-4">
                                    <div class="max-w-[450px] w-full">
                                        <InversionCard lang={lang} />
                                    </div>
                                </div>
                            )}
                            {slide.secondaryImage &&
                                !slide.secondaryComponent && (
                                    <div class="hidden lg:block xl:col-span-4">
                                        <img
                                            src={slide.secondaryImage}
                                            alt=""
                                            loading="lazy"
                                            decoding="async"
                                            class="max-w-[450px] w-full"
                                        />
                                    </div>
                                )}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>

    {/* Controles */}
    <div class="absolute bottom-0 right-1/2 translate-x-1/2 z-10">
        <div class="flex items-center justify-center pb-4 md:pb-8">
            <div class="flex items-center gap-8">
                <div class="hero-dots flex items-center gap-2.5"></div>
                <SliderArrows
                    prevClass="hero-prev"
                    nextClass="hero-next"
                    size={32}
                />
            </div>
        </div>
    </div>
</section>

<style>
    /* Estilos para los dots del hero */
    .hero-dots :global(.swiper-pagination-bullet) {
        width: 8px;
        height: 8px;
        border-radius: 9999px;
        background: #e6e5e3;
        opacity: 0.6;
        transition: all 0.3s ease;
    }
    .hero-dots :global(.swiper-pagination-bullet-active) {
        width: 24px;
        background: white;
        opacity: 1;
    }
</style>

<script>
    import Swiper from "swiper";
    import { Navigation, Pagination, Autoplay } from "swiper/modules";
    import "swiper/css";

    const heroSwiper = new Swiper(".hero-swiper", {
        modules: [Navigation, Pagination, Autoplay],
        loop: true,
        speed: 1200,
        autoplay: {
            delay: 6000,
            disableOnInteraction: false,
        },
        pagination: {
            el: ".hero-dots",
            clickable: true,
        },
        navigation: {
            nextEl: ".hero-next",
            prevEl: ".hero-prev",
        },
        on: {
            slideChange(swiper) {
                const activeSlide = swiper.slides[
                    swiper.activeIndex
                ] as HTMLElement;
                const theme = activeSlide?.dataset.theme || "light";
                const header = document.getElementById("rebrand-site-header");

                if (header) {
                    header.setAttribute("data-theme", theme);
                }
            },
        },
    });

    document.addEventListener("DOMContentLoaded", () => {
        const firstSlide = document.querySelector(
            ".swiper-slide",
        ) as HTMLElement;
        const theme = firstSlide?.dataset.theme || "light";
        const header = document.getElementById("rebrand-site-header");
        if (header) {
            header.setAttribute("data-theme", theme);
        }
    });
</script>
