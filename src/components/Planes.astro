---
import { t, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

const getRows = (lang: Lang) => {
    const rows: { title: string; money: string; percent: string }[] = [];
    let i = 0;
    while (true) {
        const key = `planes.rows.${i}.title`;
        const title = t(lang, key);
        if (title === key) break;
        rows.push({
            title,
            money: t(lang, `planes.rows.${i}.money`),
            percent: t(lang, `planes.rows.${i}.percent`),
        });
        i++;
    }
    return rows;
};

const rows = getRows(lang);
const netReturn = t(lang, "planes.netReturn");
---

<div class="planes-wrapper">
    <img
        src="/planes/planes-bg.svg"
        alt=""
        aria-hidden="true"
        class="planes-bg"
    />
    <div class="planes-overlay">
        {
            rows.map((row, index) => (
                <div class="planes-row">
                    <div class="planes-row-top">
                        <span class="planes-label">{row.title}</span>
                        <span class="planes-percent">↑ {row.percent}</span>
                    </div>
                    <p class="planes-amount">{row.money}</p>
                    {index < 2 && <p class="planes-neto">{netReturn}</p>}
                </div>
            ))
        }
    </div>
</div>

<style>
    .planes-wrapper {
        display: grid;
        width: 100%;
        aspect-ratio: 1 / 1;
        container-type: inline-size;
    }
    .planes-bg,
    .planes-overlay {
        grid-area: 1 / 1;
        width: 100%;
        height: 100%;
    }
    .planes-bg {
        display: block;
    }
    .planes-overlay {
        display: grid;
        grid-template-rows: repeat(3, minmax(0, 1fr));
        font-family:
            "Inter",
            system-ui,
            -apple-system,
            sans-serif;
        -webkit-font-smoothing: antialiased;
    }
    .planes-row {
        color: #fff;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1.2cqw;
        padding: 3cqw 10cqw;
    }
    .planes-row-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2cqw;
    }
    .planes-label {
        font-size: 4cqw;
        font-weight: 500;
        letter-spacing: 0.01em;
    }
    .planes-percent {
        font-size: 3.8cqw;
        font-weight: 500;
        letter-spacing: 0.01em;
        white-space: nowrap;
    }
    .planes-amount {
        font-size: 9.5cqw;
        line-height: 1;
        font-weight: 500;
        letter-spacing: -0.02em;
        margin: 0;
    }
    .planes-neto {
        font-size: 3.6cqw;
        font-weight: 400;
        margin: 0;
        opacity: 0.75;
    }
</style>
