---

<footer class="w-full relative overflow-clip bg-white">
    {/* Background overlays */}
    <div
        class="absolute inset-0 bg-gradient-to-b from-transparent to-cream-gradient"
    >
    </div>

    <div
        class="max-w-container mx-auto px-4 md:px-8 relative pt-14 md:pt-[100px] pb-9"
    >
        <div class="grid grid-cols-5 md:grid-cols-12 gap-4 lg:gap-5">
            {/* Navigation columns */}
            <div
                class="col-span-full flex flex-col md:flex-row md:justify-between gap-y-[52px] md:px-3"
            >
                <div
                    class="flex flex-col w-full md:flex-row md:gap-x-10 md:w-fit"
                >
                    {
                        columns.map((column) => (
                            <details
                                class="footer-accordion group border-b border-divider px-[2px] md:border-none md:px-0"
                                open
                            >
                                <summary class="flex justify-between items-center py-4 cursor-pointer list-none md:hidden">
                                    <span class="text-sm font-semibold text-kapital-black">
                                        {column.title}
                                    </span>
                                    <span class="transition-transform duration-200 group-open:rotate-180">
                                        <svg
                                            width="20"
                                            height="20"
                                            viewBox="-4 -2 19 6"
                                            fill="none"
                                        >
                                            <path
                                                d="m5 3.78l4-4-0.75-0.75-3.25 3.26-3.25-3.26-0.75 0.75z"
                                                fill="currentColor"
                                            />
                                        </svg>
                                    </span>
                                </summary>
                                <p class="hidden md:block text-sm font-semibold text-kapital-black">
                                    {column.title}
                                </p>
                                <ul class="flex flex-col gap-[6px] pb-4 md:pb-0 md:mt-4">
                                    {column.links.map((link) => (
                                        <li>
                                            <a
                                                class="text-xs text-gray-1 hover:border-b hover:border-gray-1 py-[2px]"
                                                href={link.href}
                                                target={link.target || "_self"}
                                                rel={
                                                    link.target === "_blank"
                                                        ? "noopener noreferrer"
                                                        : undefined
                                                }
                                            >
                                                {link.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </details>
                        ))
                    }
                </div>

                {/* Right side: Social, contact, countries */}
                <div class="flex flex-col gap-6">
                    {/* Social media */}
                    <div
                        class="flex justify-between items-start gap-4 py-2 md:py-0 md:flex-col md:items-start md:justify-start md:gap-0"
                    >
                        <p
                            class="text-sm font-semibold text-kapital-black shrink-0"
                        >
                            Síguenos<span class="hidden md:inline">
                                en redes</span
                            >
                        </p>
                        <ul
                            class="flex flex-wrap justify-end items-center gap-5 md:mt-4 md:gap-3 md:justify-start"
                        >
                            {
                                socialLinks.map((social) => (
                                    <li>
                                        <a
                                            class="text-kapital-black"
                                            href={social.href}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            aria-label={social.name}
                                        >
                                            <svg
                                                width="24"
                                                height="24"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                            >
                                                <path
                                                    d={social.icon}
                                                    fill="currentColor"
                                                />
                                            </svg>
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>

                    {/* Contact */}
                    <div>
                        <p class="text-sm font-semibold text-kapital-black">
                            ¿Tienes dudas?
                        </p>
                        <p class="text-sm text-gray-1 mt-1">
                            Habla con nuestro equipo, <br
                                class="hidden md:inline"
                            />te ayudaremos siempre
                        </p>
                        <a
                            class="block text-xs text-kapital-black mt-3 underline"
                            href="mailto:soporte@kapital.com"
                        >
                            soporte@kapital.com
                        </a>
                    </div>

                    {/* Country links */}
                    <ul class="flex gap-6 md:flex-col gap-y-[10px] mt-auto">
                        <li>
                            <a
                                class="text-xs text-gray-1 flex items-center gap-1 w-fit"
                                href="https://kapital.com/pr/"
                                target="_blank"
                            >
                                <svg
                                    width="20"
                                    height="20"
                                    viewBox="0 0 512 512"
                                    fill="none"
                                >
                                    <defs
                                        ><clipPath id="pr-circle"
                                            ><circle cx="256" cy="256" r="256"
                                            ></circle></clipPath
                                        ></defs
                                    >
                                    <g clip-path="url(#pr-circle)"
                                        ><g
                                            fill-rule="evenodd"
                                            transform="translate(-37.3)scale(.72249)"
                                            ><path
                                                fill="#ed0000"
                                                d="M0 0h1063v708.7H0z"
                                            ></path><path
                                                fill="#fff"
                                                d="M0 141.7h1063v141.8H0zm0 283.5h1063v141.7H0z"
                                            ></path><path
                                                fill="#0050f0"
                                                d="m0 0 610 353.9L0 707.3z"
                                            ></path><path
                                                fill="#fff"
                                                d="m268.2 450.5-65.7-49-65.3 49.5 24.3-80.5-65.3-49.7 80.7-.7 25-80.2 25.6 80 80.7.1-64.9 50.2z"
                                            ></path></g
                                        ></g
                                    >
                                </svg>
                                Puerto Rico
                            </a>
                        </li>
                        <li>
                            <a
                                class="text-xs text-gray-1 flex items-center gap-1 w-fit"
                                href="https://kapital.cc/"
                                target="_blank"
                            >
                                <svg
                                    width="20"
                                    height="20"
                                    viewBox="0 0 512 512"
                                    fill="none"
                                >
                                    <defs
                                        ><clipPath id="co-circle"
                                            ><circle cx="256" cy="256" r="256"
                                            ></circle></clipPath
                                        ></defs
                                    >
                                    <g clip-path="url(#co-circle)"
                                        ><path
                                            fill="#FCD116"
                                            d="M0 0h512v256H0z"></path><path
                                            fill="#003893"
                                            d="M0 256h512v128H0z"></path><path
                                            fill="#CE1126"
                                            d="M0 384h512v128H0z"></path></g
                                    >
                                </svg>
                                Colombia
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            {/* Large logotype */}
            <a
                id="logo-link"
                class="col-span-full flex flex-col items-center my-[72px] w-full"
                href="/"
            >
                <div class="hidden md:block w-full">
                    <!-- Desktop logotype SVG -->
                    <svg
                        width="100%"
                        viewBox="0 0 1245 324"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
