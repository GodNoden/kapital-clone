<script is:inline>
    // Footer accordion responsive behavior
    const mq = window.matchMedia("(min-width: 768px)");

    function updateFooterAccordions() {
        document.querySelectorAll(".footer-accordion").forEach((details) => {
            if (mq.matches) {
                details.setAttribute("open", "");
            } else {
                details.removeAttribute("open");
            }
        });
    }

    updateFooterAccordions();
    mq.addEventListener("change", updateFooterAccordions);
</script>
