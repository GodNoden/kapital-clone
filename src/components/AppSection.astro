---
import SliderArrows from "./SliderArrows.astro";
import { t, type Lang } from "../i18n";
import Planes from "./Planes.astro";
import Pagos from "./Pagos.astro";
import ClaveDinamica from "./ClaveDinamica.astro";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

interface PhoneImage {
    bg: string;
    label?: string;
    component?: "planes" | "pagos" | "claveDinamica";
}

interface AccordionItem {
    title: string;
    body: string;
    phone: PhoneImage;
}

// Helper para obtener texto con fallback a vacío
const getText = (index: number, field: string): string => {
    const key = `appSection.items.${index}.${field}`;
    const value = t(lang, key);
    return value === key ? "" : value;
};

const items: AccordionItem[] = [
    {
        title: getText(0, "title"),
        body: getText(0, "body"),
        phone: { bg: "/app/phone-1-bg.webp", component: "planes" },
    },
    {
        title: getText(1, "title"),
        body: getText(1, "body"),
        phone: { bg: "/app/phone-2-bg.webp" },
    },
    {
        title: getText(2, "title"),
        body: getText(2, "body"),
        phone: { bg: "/app/phone-3-bg.webp", component: "claveDinamica" },
    },
    {
        title: getText(3, "title"),
        body: getText(3, "body"),
        phone: { bg: "/app/phone-4-bg.webp" },
    },
    {
        title: getText(4, "title"),
        body: getText(4, "body"),
        phone: { bg: "/app/phone-5-bg.webp", label: "/app/phone-5-label.svg" },
    },
    {
        title: getText(5, "title"),
        body: getText(5, "body"),
        phone: { bg: "/app/phone-6-bg.webp" },
    },
];
---

<section class="w-full relative overflow-clip min-w-0 bg-white py-14 md:py-24">
    <div
        class="grid grid-cols-5 gap-4 px-4 md:grid-cols-12 lg:gap-5 xl:px-0 w-full max-w-container mx-auto"
    >
        {/* Header - centrado */}
        <div
            class="col-span-full max-w-[793px] mx-auto w-full flex flex-col lg:items-center gap-2 lg:gap-8 lg:text-center mb-8 lg:mb-24"
        >
            <p class="text-sm font-semibold text-gray-1">
                {t(lang, "appSection.eyebrow")}
            </p>
            <h2 class="text-4xl md:text-5xl text-kapital-black">
                {t(lang, "appSection.title")}
            </h2>
        </div>

        {/* Desktop layout */}
        <div class="hidden md:contents">
            {/* Accordion - izquierda */}
            <div
                class="md:col-span-5 flex flex-col justify-center"
                data-accordion
                data-always-one-open="true"
            >
                {
                    items.map((item, i) => (
                        <div
                            class="group border-b border-divider px-[2px]"
                            data-accordion-item
                            data-open={i === 0 ? "true" : "false"}
                        >
                            <button
                                type="button"
                                class="flex w-full items-center gap-6 py-4 md:py-6 text-left cursor-pointer"
                                aria-expanded={i === 0}
                                data-accordion-trigger
                            >
                                <span class="flex-1 text-kapital-black text-lg font-semibold">
                                    {item.title}
                                </span>
                                <span
                                    class="shrink-0 text-kapital-black transition-transform duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-[open=true]:rotate-180"
                                    aria-hidden="true"
                                >
                                    <svg
                                        width="14"
                                        height="14"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                    >
                                        <path
                                            d="M22 8L12 18L2 8"
                                            stroke="currentColor"
                                            stroke-width="2.5"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        />
                                    </svg>
                                </span>
                            </button>
                            <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-[open=true]:grid-rows-[1fr]">
                                <div class="overflow-hidden">
                                    <p class="pb-4 md:pb-6 text-base text-gray-1">
                                        {item.body}
                                    </p>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>

            {/* Phone images + Dots - derecha (TODO EN EL MISMO CONTENEDOR) */}
            <div
                class="md:col-span-7 flex flex-row items-center justify-between gap-20 ml-[84px]"
            >
                <div
                    class="relative overflow-hidden rounded-[28px] w-full max-w-[500px] aspect-[500/670]"
                >
                    {
                        items.map((item, i) => (
                            <div
                                class="monitoring-phone-img absolute inset-0 w-full h-full transition-[opacity,transform] duration-[900ms] ease-[cubic-bezier(0.16,1,0.3,1)]"
                                data-phone-index={i}
                                style={
                                    i === 0
                                        ? "opacity: 1; transform: translateY(0%) scale(1); z-index: 2;"
                                        : "opacity: 0; transform: translateY(4%) scale(1.02); z-index: 1;"
                                }
                            >
                                <img
                                    src={item.phone.bg}
                                    alt={item.title}
                                    width="500"
                                    height="670"
                                    class="absolute inset-0 w-full h-full object-cover"
                                    loading={i === 0 ? "eager" : "lazy"}
                                    decoding="async"
                                />
                                {item.phone.label && (
                                    <img
                                        src={item.phone.label}
                                        alt=""
                                        width="300"
                                        height="300"
                                        class="absolute w-full object-contain bottom-0 left-0 right-0 mx-auto max-w-[300px]"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                )}
                                {item.phone.component === "planes" && (
                                    <div class="absolute w-full bottom-0 left-0 right-0 mx-auto max-w-[300px]">
                                        <Planes lang={lang} />
                                    </div>
                                )}
                                {item.phone.component === "claveDinamica" && (
                                    <div class="absolute w-full bottom-0 left-0 right-0 mx-auto max-w-[300px]">
                                        <ClaveDinamica lang={lang} />
                                    </div>
                                )}
                                {item.phone.component === "pagos" && (
                                    <div class="absolute w-full bottom-0 left-0 right-0 mx-auto max-w-[300px]">
                                        <Pagos lang={lang} />
                                    </div>
                                )}
                            </div>
                        ))
                    }
                    {
                        /* Overlay en degradado: oscurece solo la base (para legibilidad del label), deja el resto de la foto con su brillo real */
                    }
                    <div
                        class="absolute inset-0 bg-black/35 rounded-[28px] pointer-events-none"
                    >
                    </div>
                </div>

                {
                    /* Dots verticales - AHORA DENTRO del contenedor de imágenes */
                }
                <div
                    class="flex relative h-full flex-col justify-center items-end"
                >
                    <div
                        id="monitoring-dots-desktop"
                        class="flex flex-col gap-[10px]"
                    >
                        {
                            items.map((_, i) => (
                                <button
                                    type="button"
                                    class:list={[
                                        "h-2 w-2 rounded-full transition-all duration-300",
                                        i === 0
                                            ? "bg-kapital-black h-6"
                                            : "bg-gray-4",
                                    ]}
                                    data-dot-index={i}
                                    aria-label={`Ir a ${items[i].title}`}
                                />
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>

        {/* Mobile layout */}
        <div class="md:hidden col-span-full">
            <div class="swiper monitoring-mobile-swiper !overflow-visible">
                <div class="swiper-wrapper">
                    {
                        items.map((item) => (
                            <div class="swiper-slide flex flex-col gap-6">
                                <div class="relative overflow-hidden rounded-[28px] w-full max-w-[500px] aspect-[500/670] mx-auto">
                                    <div class="relative w-full h-full">
                                        <img
                                            src={item.phone.bg}
                                            alt={item.title}
                                            class="absolute inset-0 w-full h-full object-cover"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                        {item.phone.label && (
                                            <img
                                                src={item.phone.label}
                                                alt=""
                                                class="absolute w-full object-contain bottom-0 left-0 right-0 mx-auto max-w-[300px]"
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        )}
                                        {item.phone.component === "planes" && (
                                            <div class="absolute w-full bottom-0 left-0 right-0 mx-auto max-w-[300px]">
                                                <Planes lang={lang} />
                                            </div>
                                        )}
                                        {item.phone.component ===
                                            "claveDinamica" && (
                                            <div class="absolute w-full bottom-0 left-0 right-0 mx-auto max-w-[300px]">
                                                <ClaveDinamica lang={lang} />
                                            </div>
                                        )}
                                        {item.phone.component === "pagos" && (
                                            <div class="absolute w-full bottom-0 left-0 right-0 mx-auto max-w-[300px]">
                                                <Pagos lang={lang} />
                                            </div>
                                        )}
                                    </div>
                                </div>
                                <div>
                                    <h3 class="pt-6 text-xl font-semibold text-kapital-black">
                                        {item.title}
                                    </h3>
                                    <p class="text-sm text-gray-1 mt-4">
                                        {item.body}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>

            {/* Dots horizontales mobile */}
            <div class="flex justify-center mt-12">
                <div
                    id="monitoring-dots-mobile"
                    class="flex flex-row gap-[10px]"
                >
                    {
                        items.map((_, i) => (
                            <button
                                type="button"
                                class:list={[
                                    "h-2 w-2 rounded-full transition-all duration-300",
                                    i === 0
                                        ? "bg-kapital-black w-6"
                                        : "bg-gray-4",
                                ]}
                                data-dot-index={i}
                                aria-label={`Ir a ${items[i].title}`}
                            />
                        ))
                    }
                </div>
            </div>
        </div>
    </div>

    <script>
        import Swiper from "swiper";
        import { Pagination } from "swiper/modules";

        // Desktop: Accordion + Phone images
        const accordion =
            document.querySelector<HTMLElement>("[data-accordion]");
        const phoneImages = Array.from(
            document.querySelectorAll<HTMLElement>(".monitoring-phone-img"),
        );
        const desktopDots = Array.from(
            document.querySelectorAll<HTMLButtonElement>(
                "#monitoring-dots-desktop button",
            ),
        );
        const mobileDots = Array.from(
            document.querySelectorAll<HTMLButtonElement>(
                "#monitoring-dots-mobile button",
            ),
        );

        function setActiveIndex(index: number) {
            // Update accordion items
            accordion
                ?.querySelectorAll<HTMLElement>("[data-accordion-item]")
                .forEach((item, i) => {
                    const isOpen = i === index;
                    item.dataset.open = String(isOpen);
                    item.querySelector(
                        "[data-accordion-trigger]",
                    )?.setAttribute("aria-expanded", String(isOpen));
                });

            // Update phone images with a crossfade (opacity + subtle translate).
            // The active slide always gets the higher z-index so it fully
            // covers the outgoing one — no container background can ever
            // show through mid-transition, so there is no gray flash.
            phoneImages.forEach((el, i) => {
                if (i === index) {
                    el.style.zIndex = "2";
                    el.style.opacity = "1";
                    el.style.transform = "translateY(0%) scale(1)";
                } else {
                    el.style.zIndex = "1";
                    el.style.opacity = "0";
                    el.style.transform = "translateY(4%) scale(1.02)";
                }
            });

            // Update desktop dots
            desktopDots.forEach((dot, i) => {
                if (i === index) {
                    dot.classList.add("bg-kapital-black", "h-6");
                    dot.classList.remove("bg-gray-4");
                } else {
                    dot.classList.remove("bg-kapital-black", "h-6");
                    dot.classList.add("bg-gray-4");
                }
            });

            // Update mobile dots
            mobileDots.forEach((dot, i) => {
                if (i === index) {
                    dot.classList.add("bg-kapital-black", "w-6");
                    dot.classList.remove("bg-gray-4");
                } else {
                    dot.classList.remove("bg-kapital-black", "w-6");
                    dot.classList.add("bg-gray-4");
                }
            });
        }

        // Accordion triggers
        accordion
            ?.querySelectorAll<HTMLElement>("[data-accordion-trigger]")
            .forEach((trigger, i) => {
                trigger.addEventListener("click", () => setActiveIndex(i));
            });

        // Desktop dot triggers
        desktopDots.forEach((dot, i) => {
            dot.addEventListener("click", () => setActiveIndex(i));
        });

        // Mobile dot triggers
        mobileDots.forEach((dot, i) => {
            dot.addEventListener("click", () => setActiveIndex(i));
        });

        // Mobile: Swiper
        const mobileSwiper = new Swiper(".monitoring-mobile-swiper", {
            modules: [Pagination],
            slidesPerView: 1,
            spaceBetween: 20,
            grabCursor: true,
            on: {
                slideChange(swiper) {
                    setActiveIndex(swiper.realIndex);
                },
            },
        });
    </script>
</section>
