---
import { getEcosystemCards } from "../data/ecosystem";
import EcosystemPopup from "./EcosystemPopup.astro";
import SliderArrows from "./SliderArrows.astro";
import { t, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const ecosystemCards = getEcosystemCards(lang);
---

<section class="w-full overflow-hidden bg-white">
    <div class="max-w-container mx-auto px-4 md:px-8 pt-20 md:pt-28">
        <div class="flex flex-col gap-4 md:gap-10 md:col-span-8">
            <h2 class="text-4xl md:text-5xl text-kapital-black text-balance">
                {t(lang, "ecosystem.title")}
            </h2>
            <p class="text-lg md:text-xl text-gray-1 text-pretty max-w-[600px]">
                {t(lang, "ecosystem.subtitle")}
            </p>
        </div>

        <div class="flex flex-col gap-8 mt-10 mb-16 md:my-14">
            <div
                class="ecosystem-swiper h-[540px] xl:h-[640px] w-full !overflow-visible"
            >
                <div class="swiper-wrapper" style="cursor: grab;">
                    {
                        ecosystemCards.map((card, index) => (
                            <div class="swiper-slide !w-[85vw] !max-w-[1202px]">
                                <article class="relative flex flex-col justify-end gap-y-6 md:justify-between overflow-hidden rounded-[22px] bg-white p-6 md:p-8 xl:p-[72px] w-full h-[540px] xl:h-[640px]">
                                    <div class="absolute inset-0">
                                        <img
                                            src={card.image}
                                            alt={card.title}
                                            loading="lazy"
                                            decoding="async"
                                            class="absolute inset-0 w-full h-full object-cover pointer-events-none"
                                        />
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/75 to-transparent md:bg-gradient-to-r md:from-black/75 md:to-transparent" />
                                    </div>

                                    <div class="relative flex flex-col gap-3 text-white w-full max-w-[488px]">
                                        <p class="text-sm md:text-base font-semibold">
                                            {card.eyebrow}
                                        </p>
                                        <h3 class="text-2xl md:text-3xl">
                                            {card.title}
                                        </h3>
                                    </div>

                                    <div class="relative shrink-0">
                                        <button
                                            type="button"
                                            data-ecosystem-trigger={index}
                                            class="inline-flex items-center justify-center px-6 py-5 rounded-full text-base lg:text-lg text-white bg-white/20 backdrop-blur-md hover:bg-white/30 transition-colors"
                                        >
                                            {t(lang, "ecosystem.moreInfo")}
                                        </button>
                                    </div>
                                </article>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="flex items-center gap-9 md:gap-12 h-[30px]">
                <div
                    class="flex-1 h-[3px] w-full rounded-full overflow-hidden bg-gray-4"
                >
                    <div
                        id="ecosystem-progress"
                        class="h-full bg-kapital-black rounded-full transition-all duration-1000 ease-out"
                        style={`width: ${100 / ecosystemCards.length}%`}
                    >
                    </div>
                </div>

                <SliderArrows
                    prevClass="ecosystem-prev"
                    nextClass="ecosystem-next"
                />
            </div>
        </div>
    </div>

    {
        ecosystemCards.map((card, index) => (
            <EcosystemPopup card={card} index={index} />
        ))
    }
</section>

<script>
    import Swiper from "swiper";
    import { Navigation } from "swiper/modules";

    const swiper = new Swiper(".ecosystem-swiper", {
        modules: [Navigation],
        slidesPerView: "auto",
        spaceBetween: 24,
        grabCursor: true,
        watchSlidesProgress: true, // ← agregar esto
        navigation: {
            nextEl: ".ecosystem-next",
            prevEl: ".ecosystem-prev",
        },
        on: {
            slideChange(s) {
                const bar = document.getElementById("ecosystem-progress");
                if (!bar) return;

                // Contar solo slides reales (excluye los duplicados si hay loop)
                const realSlides = Array.from(
                    s.slides.filter(
                        (slide) =>
                            !slide.classList.contains("swiper-slide-duplicate"),
                    ),
                );
                const total = realSlides.length;

                // Encontrar el último slide visible en pantalla
                const visibleSlides = realSlides.filter((slide) =>
                    slide.classList.contains("swiper-slide-visible"),
                );
                const lastVisible =
                    visibleSlides[visibleSlides.length - 1] ||
                    s.slides[s.activeIndex];

                const currentIndex = realSlides.indexOf(lastVisible);
                bar.style.width = `${((currentIndex + 1) / total) * 100}%`;
            },
        },
    });

    // Popups
    function openPopup(index: number) {
        const el = document.getElementById(`ecosystem-popup-${index}`);
        el?.classList.remove("opacity-0", "pointer-events-none");
        el?.classList.add("opacity-100");
        document.body.style.overflow = "hidden";
    }

    function closePopup(index: number) {
        const el = document.getElementById(`ecosystem-popup-${index}`);
        el?.classList.add("opacity-0", "pointer-events-none");
        el?.classList.remove("opacity-100");
        document.body.style.overflow = "";
    }

    document.querySelectorAll("[data-ecosystem-trigger]").forEach((btn) => {
        btn.addEventListener("click", () => {
            const idx = parseInt(
                (btn as HTMLElement).dataset.ecosystemTrigger ?? "0",
                10,
            );
            openPopup(idx);
        });
    });

    document.querySelectorAll("[data-popup-close]").forEach((btn) => {
        btn.addEventListener("click", (e) => {
            e.stopPropagation();
            const idx = parseInt(
                (btn as HTMLElement).dataset.popupId ?? "0",
                10,
            );
            closePopup(idx);
        });
    });

    document.querySelectorAll(".ecosystem-popup").forEach((popup) => {
        popup.addEventListener("click", (e) => {
            if (e.target === popup) {
                const idx = parseInt(
                    (popup as HTMLElement).dataset.popupId ?? "0",
                    10,
                );
                closePopup(idx);
            }
        });
    });
</script>
