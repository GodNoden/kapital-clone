---
import SliderArrows from "./SliderArrows.astro";
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

interface Award {
  logo: string;
  title: string;
  url: string; // ← antes "link", ahora "url" (dato, no se traduce)
}

// Helper para obtener texto con fallback a vacío
const getText = (index: number, field: string): string => {
  const key = `awards.items.${index}.${field}`;
  const value = t(lang, key);
  return value === key ? "" : value;
};

const awards: Award[] = [
  {
    logo: "/awards/mex.svg",
    title: getText(0, "title"),
    url: getText(0, "url"),
  },
  {
    logo: "/awards/mod.svg",
    title: getText(1, "title"),
    url: getText(1, "url"),
  },
  {
    logo: "/awards/wef.svg",
    title: getText(2, "title"),
    url: getText(2, "url"),
  },
  {
    logo: "/awards/cnbc.svg",
    title: getText(3, "title"),
    url: getText(3, "url"),
  },
  {
    logo: "/awards/forbes.svg",
    title: getText(4, "title"),
    url: getText(4, "url"),
  },
];
---

<section class="w-full bg-kapital-black font-inter overflow-hidden">
  <div class="max-w-container mx-auto py-12 md:py-44 px-4">
    {/* Header */}
    <div class="flex items-center justify-between mb-16 gap-8">
      <h2 class="text-2xl md:text-3xl text-white">
        {t(lang, "awards.title")}
      </h2>
      <div class="flex justify-end mt-10 md:mt-12">
        <SliderArrows
          prevClass="awards-prev"
          nextClass="awards-next"
          tone="dark"
        />
      </div>
    </div>

    {/* Swiper */}
    <div class="swiper awards-swiper w-full !overflow-visible">
      <div class="swiper-wrapper">
        {
          awards.map((award) => (
            <div class="swiper-slide !w-auto">
              <div class="flex flex-col gap-5 w-[80vw] max-w-[272px] md:w-auto md:max-w-none md:min-w-[386px] rounded-2xl shrink-0">
                <div class="flex items-center h-12">
                  <img
                    src={award.logo}
                    alt=""
                    class="h-auto max-h-12 w-auto"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="flex flex-col gap-3">
                  <h3 class="text-base md:text-lg text-white whitespace-normal md:whitespace-nowrap">
                    {award.title}
                  </h3>
                  <a
                    href={award.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 py-1 text-sm text-white font-medium hover:opacity-70 transition-opacity"
                  >
                    {t(lang, "awards.cta")}
                    <svg
                      width="16"
                      height="16"
                      viewBox="-1.5 -3.5 10.5 18"
                      fill="none"
                    >
                      <path
                        d="M5.2077 5.5L0.75 1.0423L1.77115 0.0211484L7.25 5.5L1.77115 10.9788L0.75 9.95769L5.2077 5.5Z"
                        fill="currentColor"
                      />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Navigation } from "swiper/modules";

  new Swiper(".awards-swiper", {
    modules: [Navigation],
    slidesPerView: "auto",
    spaceBetween: 96,
    grabCursor: true,
    navigation: {
      nextEl: ".awards-next",
      prevEl: ".awards-prev",
    },
  });
</script>
