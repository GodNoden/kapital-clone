---
import AnnouncementBar from "./AnnouncementBar.astro";

interface SubItem {
    label: string;
    href: string;
}

interface NavGroup {
    title: string;
    links: SubItem[];
}

interface NavItem {
    label: string;
    href: string;
    groups?: NavGroup[];
}

const navigation: NavItem[] = [
    {
        label: "Empresas",
        href: "/empresas",
        groups: [
            {
                title: "FX",
                links: [
                    { label: "Efectivo", href: "/divisas/efectivo" },
                    {
                        label: "Transferencias",
                        href: "/divisas/transferencias",
                    },
                    { label: "Cheques", href: "/divisas/cheques" },
                    { label: "Crédito CLIC", href: "/divisas/credito-clic" },
                    { label: "Transferencias Vostro", href: "/divisas/vostro" },
                    { label: "SPID", href: "/divisas/spid" },
                ],
            },
            {
                title: "Derivados",
                links: [
                    { label: "Forward", href: "/derivados/forward" },
                    { label: "Tasas", href: "/derivados/tasas" },
                ],
            },
            {
                title: "Créditos",
                links: [
                    {
                        label: "Crédito Empresarial",
                        href: "/credito/empresarial",
                    },
                    { label: "Crédito PyME", href: "/credito/pyme" },
                    { label: "Crédito FLEX", href: "/credito/flex" },
                    { label: "Factoraje", href: "/credito/factoraje" },
                ],
            },
            {
                title: "Inversiones",
                links: [
                    { label: "Pagaré", href: "/inversiones/pagare" },
                    { label: "CEDE", href: "/inversiones/cedes" },
                ],
            },
            {
                title: "Cuentas",
                links: [
                    {
                        label: "Cuenta Empresarial",
                        href: "/cuentas/empresarial",
                    },
                    { label: "Cuenta PyME", href: "/cuentas/pyme" },
                ],
            },
            {
                title: "Servicios",
                links: [
                    {
                        label: "Banca Empresarial",
                        href: "/servicios/banca-digital",
                    },
                    {
                        label: "Banca en línea",
                        href: "/servicios/banca-en-linea",
                    },
                    { label: "Kapital IA", href: "/servicios/ia" },
                ],
            },
        ],
    },
    {
        label: "Personas",
        href: "/personas",
        groups: [
            {
                title: "FX",
                links: [
                    { label: "Efectivo", href: "/divisas/efectivo-personas" },
                    {
                        label: "Transferencias",
                        href: "/divisas/transferencias-personas",
                    },
                    { label: "Cheques", href: "/divisas/cheques-personas" },
                ],
            },
            {
                title: "Derivados",
                links: [
                    {
                        label: "Forward NDF",
                        href: "/derivados/forward-personas",
                    },
                    { label: "Tasas", href: "/derivados/tasas-personas" },
                ],
            },
            {
                title: "Inversiones",
                links: [
                    { label: "Pagaré", href: "/inversiones/pagare-personas" },
                    { label: "CEDE", href: "/inversiones/cedes-personas" },
                    { label: "Plan Crece", href: "/inversiones/plan-crece" },
                ],
            },
            {
                title: "Cuentas",
                links: [
                    {
                        label: "Nómina Kapital",
                        href: "/cuentas/nomina-kapital",
                    },
                    { label: "Nómina Básica", href: "/cuentas/nomina-basica" },
                    {
                        label: "Cuenta Kapital",
                        href: "/cuentas/kapital-personas",
                    },
                    { label: "Cuenta Básica", href: "/cuentas/basica" },
                    { label: "Cuenta Express", href: "/cuentas/express" },
                    { label: "Mi Cuenta Kids", href: "/cuentas/kids" },
                ],
            },
            {
                title: "Servicios",
                links: [
                    { label: "Kapital App", href: "/servicios/app" },
                    {
                        label: "Banca Patrimonial",
                        href: "/servicios/patrimonial",
                    },
                    { label: "Sucursales", href: "/servicios/sucursales" },
                ],
            },
        ],
    },
    {
        label: "Grupo Financiero",
        href: "/grupo-financiero",
    },
];

const entrarLinks = [
    { label: "Plataforma empresarial", href: "https://app.kapital.com/" },
    { label: "Banca en línea", href: "https://www.ieb.com.mx/NB/" },
];
---

<header
    id="rebrand-site-header"
    class="group/site-header group/header fixed top-0 left-0 z-50 w-full bg-transparent transition-all duration-[1000ms] ease-[cubic-bezier(0.16,1,0.3,1)]"
    data-sticky="false"
    data-mobile-menu-open="false"
>
    <AnnouncementBar />

    <div class="group/header-inner relative w-full">
        {
            /* Capa de fondo animada: el color/opacidad cambia con hover o al hacer scroll (sticky) */
        }
        <div
            class="nav-background absolute w-full h-full -z-10 pointer-events-none
             bg-transparent backdrop-blur-none
             transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]
             md:group-hover/site-header:bg-[rgba(236,235,234,0.75)]
             md:group-hover/site-header:backdrop-blur-[50px]
             md:group-data-[sticky=true]/site-header:bg-[rgba(236,235,234,0.75)]
             md:group-data-[sticky=true]/site-header:backdrop-blur-[50px]
             max-md:group-data-[mobile-menu-open=true]/site-header:!bg-[rgba(236,235,234,0.9)]
             max-md:group-data-[mobile-menu-open=true]/site-header:!backdrop-blur-[75px]"
            aria-hidden="true"
        >
        </div>

        <div
            class="max-w-[700px] mx-auto px-6 md:px-8 flex items-center justify-between py-2.5 w-full relative z-50"
        >
            {/* Logo + Nav agrupados a la izquierda */}
            <div class="flex items-center gap-11">
                <a
                    href="/"
                    aria-label="Inicio"
                    class="flex-shrink-0 transition-colors duration-500
         text-kapital-black
         group-data-[theme=dark]/site-header:text-white
         group-data-[sticky=true]/site-header:!text-kapital-black
         md:group-hover/header:text-kapital-black"
                >
                    <svg
                        width="30"
                        height="30"
                        class="md:w-[35px] md:h-[35px]"
                        viewBox="0 0 31 35"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M25.2889 29.5449H30.4752L24.6406 19.2644C24.2705 18.6161 24.0844 17.9678 24.0844 17.3195C24.0844 16.6713 24.2705 16.023 24.6406 15.3747L30.4752 5.09422H25.2889L19.7305 14.7264C19.1743 15.6528 18.8981 16.5792 18.8981 17.3195C18.8981 18.0599 19.1743 18.9863 19.7305 19.9127L25.2889 29.5449ZM13.6179 16.6713C14.7303 16.6713 15.6548 16.4852 16.3971 16.023C16.9533 15.7468 17.6016 15.0966 18.1578 14.0781L23.8083 4.44593L21.3072 0L15.1945 10.1865C14.8243 10.8348 14.3621 11.2989 13.8059 11.5751C13.1576 11.9453 12.6014 12.0373 11.861 12.0373H0.00391712L2.59705 16.5753L13.6198 16.6673V16.6713H13.6179ZM21.3052 34.8252L23.8043 30.3792L18.1539 20.747C17.5977 19.7286 16.9494 19.0803 16.3931 18.8022C15.6509 18.34 14.7264 18.1539 13.614 18.1539L2.59118 18.2459L0 22.782H11.8552C12.5975 22.782 13.1517 22.874 13.8 23.2442C14.3562 23.5204 14.8185 23.9865 15.1886 24.6348L21.3013 34.8212V34.8252H21.3052Z"
                            fill="currentColor"></path>
                    </svg>
                </a>

                {/* Desktop Nav */}
                <nav
                    id="main-nav"
                    class="hidden md:flex items-center"
                    aria-label="Navegación principal"
                >
                    <ul role="list" class="flex items-center gap-3">
                        {
                            navigation.map((item) => (
                                <li class="relative group/trigger">
                                    <a
                                        href={item.href}
                                        class="menu-trigger text-sm flex items-center transition-all duration-300 py-2
         text-kapital-black 
         group-data-[theme=dark]/site-header:text-white 
         group-data-[sticky=true]/site-header:!text-kapital-black 
         md:group-hover/header:text-kapital-black
         hover:opacity-70"
                                    >
                                        {item.label}
                                        {item.groups && (
                                            <svg
                                                class="w-4 ms-1 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/trigger:rotate-180"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                            >
                                                <path d="M6 9l6 6 6-6" />
                                            </svg>
                                        )}
                                    </a>

                                    {item.groups && (
                                        <>
                                            {/* Puente invisible para no perder el hover al bajar al dropdown */}
                                            <span
                                                class="absolute top-full left-0 z-10 w-full h-[18px] pointer-events-auto"
                                                aria-hidden="true"
                                            />

                                            <div
                                                class="absolute top-full left-0 mt-[18px] p-4 flex flex-row gap-6 rounded-md
                             bg-[rgba(237,235,233,0.75)] backdrop-blur-[25px]
                             opacity-0 pointer-events-none translate-y-2
                             group-hover/trigger:opacity-100 group-hover/trigger:pointer-events-auto
                             group-hover/trigger:translate-y-0 transition-all duration-500 z-20"
                                            >
                                                {item.groups.map((group) => (
                                                    <div class="min-w-36">
                                                        <p class="text-xs font-semibold text-gray-1 tracking-wider mb-2 whitespace-nowrap">
                                                            {group.title}
                                                        </p>
                                                        <ul class="flex flex-col gap-1">
                                                            {group.links.map(
                                                                (link) => (
                                                                    <li>
                                                                        <a
                                                                            href={
                                                                                link.href
                                                                            }
                                                                            class="block py-1 text-kapital-black text-sm whitespace-nowrap hover:opacity-70"
                                                                        >
                                                                            {
                                                                                link.label
                                                                            }
                                                                        </a>
                                                                    </li>
                                                                ),
                                                            )}
                                                        </ul>
                                                    </div>
                                                ))}
                                            </div>
                                        </>
                                    )}
                                </li>
                            ))
                        }
                    </ul>
                </nav>
            </div>

            {/* Actions (derecha) */}
            <div class="flex items-center gap-6 md:gap-[10px] relative">
                <a
                    href="https://onboarding.kapital.com/"
                    class="text-sm px-4 py-2 rounded-full transition-colors whitespace-nowrap text-kapital-black
           transition-colors whitespace-nowrap
           bg-[rgba(191,187,178)]
           md:group-hover/header:text-kapital-black
           group-data-[sticky=true]/site-header:text-kapital-black
           hover:bg-[rgba(191,187,178,0.8)]"
                >
                    Abrir cuenta
                </a>

                {/* Dropdown "Entrar" */}
                <div class="relative hidden md:block" id="entrar-container">
                    <button
                        type="button"
                        class="group entrar-trigger flex items-center translate-x-2 text-sm transition-all duration-300 py-2
                           text-kapital-black
                           group-data-[theme=dark]/site-header:text-white
                           group-data-[sticky=true]/site-header:!text-kapital-black
                           group-hover/header:text-kapital-black
                           hover:opacity-70"
                    >
                        Entrar
                        <svg
                            class="w-4 ms-1 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-aria-[expanded=true]:rotate-180"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path d="M6 9l6 6 6-6"></path>
                        </svg>
                    </button>

                    <span
                        class="absolute top-full right-0 z-10 w-full h-[18px] pointer-events-auto"
                        aria-hidden="true"></span>

                    <div
                        id="entrar-dropdown"
                        class="absolute right-0 top-full mt-[18px] w-fit p-4 rounded-md
                   bg-[rgba(237,235,233,0.75)] backdrop-blur-[25px]
                   transition-all duration-500 z-20 flex flex-col
                   opacity-0 invisible translate-y-2 pointer-events-none"
                    >
                        {
                            entrarLinks.map((link, i) => (
                                <>
                                    {i > 0 && (
                                        <div class="h-px bg-divider my-2" />
                                    )}
                                    <a
                                        href={link.href}
                                        class="text-kapital-black text-sm whitespace-nowrap hover:opacity-70 py-1"
                                    >
                                        {link.label}
                                    </a>
                                </>
                            ))
                        }
                    </div>
                </div>

                {/* Mobile menu button */}
                <button
                    id="mobile-menu-btn"
                    class="group menu-trigger-close md:hidden transition-all duration-300
         text-kapital-black
         group-data-[theme=dark]/site-header:text-white
         group-data-[sticky=true]/site-header:!text-kapital-black
         group-hover/header:text-kapital-black
         hover:opacity-70"
                >
                    <span class="block group-aria-[expanded=true]:hidden">
                        <svg
                            width="32"
                            height="32"
                            viewBox="0 0 36 32"
                            fill="none"
                        >
                            <rect
                                width="36"
                                height="1.5"
                                transform="translate(0 12.5)"
                                fill="currentColor"></rect>
                            <rect
                                width="36"
                                height="1.5"
                                transform="translate(0 18)"
                                fill="currentColor"></rect>
                        </svg>
                    </span>
                    <span class="hidden group-aria-[expanded=true]:block">
                        <svg
                            width="32"
                            height="32"
                            viewBox="0 0 36 32"
                            fill="none"
                        >
                            <rect
                                width="24"
                                height="1.5"
                                transform="translate(10 7) rotate(45)"
                                fill="currentColor"></rect>
                            <rect
                                width="24"
                                height="1.5"
                                transform="translate(9 24) rotate(-45)"
                                fill="currentColor"></rect>
                        </svg>
                    </span>
                </button>
            </div>
        </div>

        {/* Mobile Menu Panel */}
        <div
            id="mobile-menu-panel"
            class="absolute top-full left-0 w-full bg-[rgba(236,235,234,0.90)] backdrop-blur-[75px]
             z-40 overflow-hidden h-0 opacity-0 invisible
             transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] md:hidden"
        >
            <div
                class="flex flex-col px-5 py-6 h-[calc(100vh-72px)] overflow-y-auto w-full"
            >
                {/* Entrar */}
                <div class="flex flex-col gap-2 pb-6">
                    <p class="text-sm text-gray-1 tracking-wider">Entrar</p>
                    <ul class="flex flex-col gap-[6px]">
                        {
                            entrarLinks.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        class="py-1 text-sm text-kapital-black"
                                    >
                                        {link.label}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                {/* Accordions */}
                {
                    navigation.map((item) =>
                        item.groups ? (
                            <details class="mobile-accordion group border-b border-gray-300/50">
                                <summary class="flex justify-between items-center py-4 cursor-pointer list-none">
                                    <span class="text-lg font-semibold text-kapital-black">
                                        {item.label}
                                    </span>
                                    <span class="transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-open:rotate-180">
                                        <svg
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                        >
                                            <path d="M6 9l6 6 6-6" />
                                        </svg>
                                    </span>
                                </summary>
                                <div class="accordion-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">
                                    <div class="overflow-hidden">
                                        <div class="flex flex-col gap-8 mb-2">
                                            {item.groups.map((group) => (
                                                <div class="flex flex-col gap-3">
                                                    <p class="text-sm font-semibold text-gray-1 tracking-wider">
                                                        {group.title}
                                                    </p>
                                                    <ul class="flex flex-col gap-[6px]">
                                                        {group.links.map(
                                                            (link) => (
                                                                <li>
                                                                    <a
                                                                        href={
                                                                            link.href
                                                                        }
                                                                        class="py-1 text-sm text-kapital-black"
                                                                    >
                                                                        {
                                                                            link.label
                                                                        }
                                                                    </a>
                                                                </li>
                                                            ),
                                                        )}
                                                    </ul>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </details>
                        ) : (
                            <div class="border-b border-gray-300/50 py-4">
                                <a
                                    href={item.href}
                                    class="flex justify-between items-center text-lg font-semibold text-kapital-black w-full"
                                >
                                    {item.label}
                                    <svg
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                    >
                                        <path
                                            d="M10 16L14 12L10 8"
                                            stroke="currentColor"
                                            stroke-width="1.4"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        />
                                    </svg>
                                </a>
                            </div>
                        ),
                    )
                }
            </div>
        </div>
    </div>
</header>

<script is:inline>
    (function () {
        const header = document.getElementById("rebrand-site-header");
        const entrarContainer = document.getElementById("entrar-container");
        const entrarTrigger = entrarContainer?.querySelector(".entrar-trigger");
        const entrarDropdown = document.getElementById("entrar-dropdown");
        const mobileMenuBtn = document.getElementById("mobile-menu-btn");
        const mobilePanel = document.getElementById("mobile-menu-panel");
        let closeTimer;

        if (!header) return;

        /* ===== Dropdown "Entrar" con delay de cierre ===== */
        function openEntrar() {
            clearTimeout(closeTimer);
            if (entrarDropdown && entrarTrigger) {
                entrarTrigger.setAttribute("aria-expanded", "true");
                entrarDropdown.classList.remove(
                    "opacity-0",
                    "invisible",
                    "translate-y-2",
                    "pointer-events-none",
                );
                entrarDropdown.classList.add(
                    "opacity-100",
                    "visible",
                    "translate-y-0",
                );
            }
        }

        function closeEntrar() {
            closeTimer = setTimeout(() => {
                if (entrarDropdown && entrarTrigger) {
                    entrarTrigger.setAttribute("aria-expanded", "false");
                    entrarDropdown.classList.remove(
                        "opacity-100",
                        "visible",
                        "translate-y-0",
                    );
                    entrarDropdown.classList.add(
                        "opacity-0",
                        "invisible",
                        "translate-y-2",
                        "pointer-events-none",
                    );
                }
            }, 150);
        }

        if (entrarContainer && entrarTrigger && entrarDropdown) {
            entrarContainer.addEventListener("mouseenter", openEntrar);
            entrarContainer.addEventListener("mouseleave", closeEntrar);
            entrarDropdown.addEventListener("mouseenter", () =>
                clearTimeout(closeTimer),
            );
        }

        /* ===== Links que navegan al hacer click en el label principal ===== */
        document.querySelectorAll(".menu-trigger").forEach((trigger) => {
            trigger.addEventListener("click", (e) => {
                // Deja que el <a> navegue de forma normal; no se necesita JS extra aquí
            });
        });

        header.addEventListener("mouseleave", closeEntrar);

        /* ===== Sticky / hover de color-opacidad en scroll ===== */
        const updateSticky = () => {
            const isMobileMenuOpen =
                mobileMenuBtn?.getAttribute("aria-expanded") === "true";
            if (window.scrollY > 20) {
                header.setAttribute("data-sticky", "true");
            } else if (!isMobileMenuOpen) {
                header.setAttribute("data-sticky", "false");
            }
        };
        window.addEventListener("scroll", updateSticky, { passive: true });
        updateSticky();

        /* ===== Mobile menu ===== */
        if (mobileMenuBtn && mobilePanel) {
            mobileMenuBtn.addEventListener("click", () => {
                const isOpen =
                    mobileMenuBtn.getAttribute("aria-expanded") === "true";
                if (isOpen) {
                    mobileMenuBtn.setAttribute("aria-expanded", "false");
                    mobilePanel.style.height = "0px";
                    mobilePanel.classList.replace("opacity-100", "opacity-0");
                    mobilePanel.classList.replace("visible", "invisible");
                    document.documentElement.style.overflow = "";
                    header.setAttribute("data-mobile-menu-open", "false");
                    if (window.scrollY <= 20)
                        header.setAttribute("data-sticky", "false");
                } else {
                    mobileMenuBtn.setAttribute("aria-expanded", "true");
                    mobilePanel.style.height = "100vh";
                    mobilePanel.classList.replace("opacity-0", "opacity-100");
                    mobilePanel.classList.replace("invisible", "visible");
                    document.documentElement.style.overflow = "hidden";
                    header.setAttribute("data-mobile-menu-open", "true");
                    header.setAttribute("data-sticky", "true");
                }
            });
        }

        /* ===== Mobile accordion (solo uno abierto a la vez) ===== */
        const accordions = document.querySelectorAll(".mobile-accordion");
        accordions.forEach((accordion) => {
            const summary = accordion.querySelector("summary");
            const content = accordion.querySelector(".accordion-content");
            if (!summary || !content) return;

            summary.addEventListener("click", (e) => {
                e.preventDefault();
                if (accordion.hasAttribute("open")) {
                    content.style.gridTemplateRows = "0fr";
                    accordion.classList.remove("is-open");
                    setTimeout(() => accordion.removeAttribute("open"), 500);
                } else {
                    accordions.forEach((other) => {
                        if (other !== accordion && other.hasAttribute("open")) {
                            const otherContent =
                                other.querySelector(".accordion-content");
                            if (otherContent)
                                otherContent.style.gridTemplateRows = "0fr";
                            other.classList.remove("is-open");
                            setTimeout(
                                () => other.removeAttribute("open"),
                                500,
                            );
                        }
                    });
                    accordion.setAttribute("open", "");
                    requestAnimationFrame(() => {
                        content.style.gridTemplateRows = "1fr";
                        accordion.classList.add("is-open");
                    });
                }
            });
        });
    })();
</script>
