---
import type { EcosystemCard } from "../data/ecosystem";

interface Props {
    card: EcosystemCard;
    index: number;
}

const { card, index } = Astro.props;
const { popup } = card;
---

<div
    id={`ecosystem-popup-${index}`}
    data-popup-id={index}
    class="ecosystem-popup fixed inset-0 z-50 flex justify-center items-center px-3 py-[50px] opacity-0 pointer-events-none transition-opacity duration-500"
    style="backdrop-filter: blur(25px); background-color: rgba(102, 98, 96, 0.7);"
>
    <article
        class="relative bg-white rounded-[22px] w-full max-w-[490px] flex flex-col overflow-hidden"
        style="height: calc(100vh - 100px);"
    >
        <button
            type="button"
            data-popup-close
            data-popup-id={index}
            class="absolute top-5 right-5 md:top-6 md:right-6 z-10 flex items-center justify-center w-8 h-8 rounded-full bg-white hover:bg-gray-5 transition-colors"
            aria-label="Cerrar"
        >
            <svg width="18" height="18" viewBox="0 0 36 32" fill="none">
                <rect
                    width="24"
                    height="1.5"
                    transform="translate(10 7) rotate(45)"
                    fill="currentColor"></rect>
                <rect
                    width="24"
                    height="1.5"
                    transform="translate(9 24) rotate(-45)"
                    fill="currentColor"></rect>
            </svg>
        </button>

        <div class="px-6 pt-[72px] lg:px-14 pb-[140px] overflow-y-auto flex-1">
            <h2 class="text-3xl leading-tight text-kapital-black">
                {popup.heading}
            </h2>

            <div
                class="text-sm leading-relaxed text-gray-1 mt-4 flex flex-col gap-2"
            >
                {popup.intro.map((paragraph) => <p>{paragraph}</p>)}
            </div>

            {
                popup.bulletsHeading && (
                    <>
                        <h3 class="text-2xl leading-tight text-kapital-black mt-6">
                            {popup.bulletsHeading}
                        </h3>
                        <div class="text-sm leading-relaxed text-gray-1 mt-4">
                            <ul class="list-disc ml-5 mb-4 flex flex-col gap-2">
                                {popup.bullets?.map((bullet) => (
                                    <li>{bullet}</li>
                                ))}
                            </ul>
                            {popup.closing && <p>{popup.closing}</p>}
                        </div>
                    </>
                )
            }
        </div>

        <div
            class="absolute bottom-0 left-0 right-0 h-[150px] pointer-events-none"
            style="backdrop-filter: blur(12px); mask-image: linear-gradient(to bottom, transparent, black 50%);"
        >
        </div>

        {
            popup.cta && (
                <div class="absolute bottom-6 left-0 right-0 flex justify-center">
                    <a
                        href={popup.cta.href}
                        class="rounded-full bg-kapital-black text-white hover:bg-opacity-90 px-6 py-4 lg:px-8 lg:py-5 text-sm lg:text-base transition-colors"
                    >
                        {popup.cta.label}
                    </a>
                </div>
            )
        }
    </article>
</div>
