---
const announcement = {
    text: "Conoce por qué Kapital solicita tu Clave CIEC",
    link: "/blog/educacion-financiera/por-que-kapital-pide-tu-ciec-sat",
    linkText: "Conocer más",
};
---

<aside
    id="announcement-bar"
    class="relative overflow-hidden max-h-[100px] opacity-100 transition-opacity duration-1000"
    aria-label="Anuncio"
>
    <div class="w-full bg-kapital-black text-white py-2.5">
        <div
            class="max-w-container mx-auto px-4 flex items-center justify-center gap-6"
        >
            <p class="text-xs md:text-sm whitespace-nowrap">
                {announcement.text}
            </p>
            <a
                href={announcement.link}
                class="text-xs font-medium hover:underline whitespace-nowrap"
            >
                {announcement.linkText}
            </a>
        </div>
    </div>

    <button
        id="announcement-close"
        aria-label="Cerrar anuncio"
        class="absolute right-2 top-1/2 -translate-y-1/2 w-5 h-5 flex items-center justify-center hover:opacity-70"
    >
        <svg
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                d="M1 1L11 11M11 1L1 11"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"></path>
        </svg>
    </button>
</aside>

<script is:inline>
    const bar = document.getElementById("announcement-bar");
    const closeBtn = document.getElementById("announcement-close");
    const storageKey = "announcement-dismissed";

    // Check if already dismissed
    if (sessionStorage.getItem(storageKey) === "true") {
        bar?.remove();
    }

    closeBtn?.addEventListener("click", () => {
        sessionStorage.setItem(storageKey, "true");
        bar?.classList.add("opacity-0");
        setTimeout(() => bar?.remove(), 1000);
    });
</script>
