---
import { t, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
---

<aside
    id="rebrand-announcement"
    aria-label={t(lang, "header.announcement.close")}
    class="relative overflow-hidden max-h-[100px] opacity-100 transition-opacity duration-1000 bg-kapital-black text-white"
>
    <div class="w-full py-2.5">
        <div
            class="max-w-container mx-auto px-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 md:gap-6"
        >
            <p class="text-xs md:text-sm text-center">
                {t(lang, "header.announcement.text")}
            </p>
            <a
                href="/blog/educacion-financiera/por-que-kapital-pide-tu-ciec-sat"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-medium hover:underline whitespace-nowrap"
            >
                {t(lang, "header.announcement.link")}
            </a>
        </div>
    </div>

    <button
        id="announcement-close"
        aria-label={t(lang, "header.announcement.close")}
        class="absolute right-2 top-1/2 -translate-y-1/2 w-5 h-5 flex items-center justify-center hover:opacity-70"
    >
        <svg
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
        >
            <path
                d="M1 1L11 11M11 1L1 11"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"></path>
        </svg>
    </button>
</aside>

<script is:inline>
    const bar = document.getElementById("rebrand-announcement");
    const closeBtn = document.getElementById("announcement-close");
    const storageKey = "announcement-dismissed";

    if (sessionStorage.getItem(storageKey) === "true") {
        bar?.remove();
    }

    closeBtn?.addEventListener("click", () => {
        sessionStorage.setItem(storageKey, "true");
        bar?.classList.add("opacity-0");
        setTimeout(() => bar?.remove(), 1000);
    });
</script>
